    <div class="invoice-address">
        <address class="address-sender">
            <table cellpadding="0" cellspacing="0" width="100%" border="0">
                <tr>
                    <td>{{ invoiceSenderAddress|raw }}</td>
                </tr>
            </table>
        </address>

        <address class="address-recipient">
            {{ invoice['customer.company']|default(invoice['customer.name']) }}<br>
            {% if invoice['customer.contact'] %}
                {{ invoice['customer.contact'] }}<br>
            {% endif %}
            {{ invoice['customer.address']|nl2br }}<br>
            {{ invoice['customer.country']|country_name }}
        </address>
    </div>

    <div class="invoice-details">
        <table cellpadding="0" cellspacing="0" width="100%" border="0">
            <tr>
                <th class="invoice-details-label">{{ 'invoice.number'|trans }}:</th>
                <td class="invoice-details-value">{{ invoice['invoice.number'] }}</td>
            </tr>
            <tr>
                <th class="invoice-details-label">{{ 'invoice.service_date'|trans }}:</th>
                <td class="invoice-details-value">
                    {% if invoice['invoice.first_month'] != invoice['invoice.last_month'] or invoice['invoice.first_year'] != invoice['invoice.last_year'] %}
                        {{ invoice['invoice.first_month'] }} {{ invoice['invoice.first_year'] }}
                        &ndash;
                    {% endif %}
                    {{ invoice['invoice.last_month'] }} {{ invoice['invoice.last_year'] }}
                </td>
            </tr>
            <tr>
                <td class="invoice-details-label">{{ 'invoice.due_days'|trans }}:</td>
                <td class="invoice-details-value">{{ invoice['invoice.due_date'] }}</td>
            </tr>
            {% if invoice['customer.vat_id'] is not empty %}
                <tr>
                    <th class="invoice-details-label">{{ 'vat_id'|trans }}:</th>
                    <td class="invoice-details-value">{{ invoice['customer.vat_id'] }}</td>
                </tr>
                <tr>
                    <td colspan="2">&nbsp;</td>
                </tr>
            {% endif %}
            {% if invoice['template.contact'] is not empty %}
                {% for line in invoice['template.contact']|split("\n") %}
                    {% set lineData = line|split(':', 2) %}
                    {% if lineData|length > 1 %}
                        <tr>
                            <th class="invoice-details-label">{{ lineData[0] }}:</th>
                            <td class="invoice-details-value">{{ lineData[1] }}</td>
                        </tr>
                    {% endif %}
                {% endfor %}
            {% endif %}
            <tr>
                <td colspan="2">&nbsp;</td>
            </tr>
            <tr>
                <td class="invoice-details-label">{{ 'date'|trans }}:</td>
                <td class="invoice-details-value">{{ invoice['invoice.date'] }}</td>
            </tr>
        </table>
    </div>

    <br>

    <div class="content">
        <!-- CONTENT_PART -->
        <div class="subject">
            <h1>{{ invoice['template.title'] }}</h1>
        </div>

        {% if introductionText %}
            <div class="introduction-text">
                <p>{{ introductionText }}</p>
            </div>
        {% endif %}

        <div class="items">
            <table cellpadding="0" cellspacing="0" width="100%" border="0">
                <thead>
                <tr>
                    <th class="text-left">Pos.</th>
                    <th class="text-left">{{ 'description'|trans }}</th>
                    <th class="text-right text-nowrap">{{ 'unit_price'|trans }}</th>
                    <th class="text-right text-nowrap">{{ 'amount'|trans }}</th>
                    <th class="text-right text-nowrap">{{ 'total_rate'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for invoiceLineItem in entries %}
                    <!-- CONTENT_PART -->
                    <tr>
                        <td class="text-left">{{ loop.index }}</td>
                        <td class="text-left">
                            {{ invoiceLineItem['entry.project'] }}:
                            {% if invoiceLineItem['entry.activity'] is defined and invoiceLineItem['entry.activity'] is not empty %}
                                <strong>
                                    {{ invoiceLineItem['entry.activity'] }}
                                </strong>
                            {% endif %}
                            {% if invoiceLineItem['entry.description'] is not empty %}
                                <br><small>{{ invoiceLineItem['entry.description'] }}</small>
                            {% endif %}
                        </td>
                        <td class="text-right text-nowrap">{{ invoiceLineItem['entry.rate'] }}</td>
                        <td class="text-right text-nowrap">{{ invoiceLineItem['entry.amount'] }}</td>
                        <td class="text-right text-nowrap">{{ invoiceLineItem['entry.total'] }}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-right text-nowrap">
                            {{ 'invoice.subtotal'|trans }}
                        </td>
                        <td class="text-right text-nowrap">{{ invoice['invoice.subtotal'] }}</td>
                    </tr>
                    {% for taxRow in invoice['invoice.tax_rows'] %}
                        {% if taxRow['show'] %}
                            <tr>
                                <td colspan="4" class="text-right text-nowrap">
                                    {{ taxRow['name']|trans }} ({{ taxRow['rate'] }}%)
                                    {% if taxRow['note'] is not null %}
                                        <sup>[{{ taxRow['counter'] }}]</sup>
                                    {% endif %}
                                </td>
                                <td class="text-right text-nowrap">{{ taxRow['amount']|money(taxRow['currency']) }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    <tr>
                        <td colspan="4" class="text-right text-nowrap">
                            <strong>{{ 'invoice.total'|trans }}</strong>
                        </td>
                        <td class="text-right text-nowrap">
                            <strong>{{ invoice['invoice.total'] }}</strong>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {% for taxRow in invoice['invoice.tax_rows'] %}
            {% if taxRow['note'] is not null %}
                <p>
                    <sup>[{{ taxRow['counter'] }}]</sup>
                    {{ taxRow['note']|trans }}
                </p>
            {% endif %}
        {% endfor %}

        {% if invoice['template.payment_terms'] is not empty %}
            <div class="paymentTerms">
                <p>
                    {{ invoice['template.payment_terms']|md2html }}
                </p>
            </div>
        {% endif %}
    </div>
</body>
</html>
